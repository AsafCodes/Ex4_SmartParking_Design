@startuml
title Sequence Diagram 1 - Spot Reservation, LPR Gate Entry & No-Show Destruction

actor Student
boundary ":StudentDashboardUI" as UI
control ":ReservationControl" as Ctrl
entity "spot : ParkingSpot" as Spot
entity "res : Reservation" as Res
entity "owner : User" as Owner
boundary ":LprGateBoundary" as LPR

' ---------------------------------------------------------------
' Part A - Reservation with optimistic locking (Edge Case A)
' ---------------------------------------------------------------
Student -> UI : onReserveSpotClicked("EV-04", "12-345-67")
activate UI
UI -> Ctrl : reserveSpot(userId, "EV-04", "12-345-67")
activate Ctrl
Ctrl -> Spot : isAvailable()
activate Spot
Spot --> Ctrl : available
deactivate Spot

alt available == true
  Ctrl -> Spot : getVersion()
  activate Spot
  Spot --> Ctrl : expectedVersion
  deactivate Spot

  Ctrl -> Spot : tryReserve(expectedVersion)
  activate Spot
  note right of Spot
    Atomic compare-and-set:
    if (version == expectedVersion)
    { status = RESERVED; version++; return true }
    else return false
  end note
  Spot --> Ctrl : acquired
  deactivate Spot

  alt acquired == true
    create Res
    Ctrl -> Res : <<create>> Reservation(userId, "EV-04", "12-345-67")
    activate Res
    Res --> Ctrl : res
    deactivate Res
    Ctrl --> UI : res
    UI -> UI : displayCountdown(15)
  else acquired == false (Concurrent Race Condition)
    Ctrl --> UI : null
    UI -> UI : showErrorAlert("Spot just reserved by another user")
  end
else available == false
  Ctrl --> UI : null
  UI -> UI : showErrorAlert("Spot unavailable")
end
deactivate Ctrl
UI --> Student : reservation result displayed
deactivate UI

== Within 15 Minutes: Vehicle Arrives at Entrance Gate ==

[-> LPR : onPlateScanned("12-345-67", "EV Zone")
activate LPR
LPR -> Ctrl : processLprGateEntry("12-345-67", "EV Zone")
activate Ctrl
Ctrl -> Res : isWithin15MinWindow()
activate Res
Res --> Ctrl : valid
deactivate Res

alt valid == true
  Ctrl -> Res : setStatus(FULFILLED)
  activate Res
  deactivate Res
  Ctrl -> Spot : setStatus(OCCUPIED)
  activate Spot
  deactivate Spot
  Ctrl -> LPR : openBarrierGate()
else valid == false (No-Show > 15 Min)
  Ctrl -> Res : setStatus(NO_SHOW_REVOKED)
  activate Res
  deactivate Res
  Ctrl -> Spot : setStatus(AVAILABLE)
  activate Spot
  deactivate Spot
  Ctrl -> Owner : incrementNoShowWarnings()
  activate Owner
  deactivate Owner
  Ctrl -> Res : <<destroy>>
  destroy Res
  Ctrl -> LPR : denyEntry()
end
Ctrl --> LPR : entryResult
deactivate Ctrl
deactivate LPR

@enduml
